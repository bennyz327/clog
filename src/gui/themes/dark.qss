/* clog dark theme.
   Indicator colours taken from hydrus default_hydrus_dark.qss.
   Structural rules added for the widgets clog actually uses. */

QMainWindow, QWidget {
    color: #dcdcdc;
}

QToolBar {
    spacing: 4px;
    padding: 2px;
    border-bottom: 1px solid #1f2123;
}

QToolButton {
    padding: 4px 8px;
}

QStatusBar {
    border-top: 1px solid #1f2123;
}

QHeaderView::section {
    background-color: #2e3236;
    color: #dcdcdc;
    padding: 4px;
    border: 1px solid #1f2123;
}

QTableView {
    alternate-background-color: #2a2d30;
    gridline-color: #3c3f41;
}

QTableView::item:selected {
    background-color: #3a78b8;
    color: #ffffff;
}

QTabBar::tab:selected {
    background: #3c3f41;
}

QSplitter::handle {
    background: #1f2123;
}

QPlainTextEdit, QTextEdit {
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
}

QFrame#NotificationManager {
    background: transparent;
}

QFrame#NotificationCard-info,
QFrame#NotificationCard-success,
QFrame#NotificationCard-warning,
QFrame#NotificationCard-error {
    border: 1px solid #1f2123;
    border-radius: 8px;
    background-color: #2f3337;
    min-width: 320px;
    max-width: 420px;
}

QFrame#NotificationCard-success {
    border-color: #2f6b36;
    background-color: #233126;
}

QFrame#NotificationCard-warning {
    border-color: #8b6d1a;
    background-color: #3a3220;
}

QFrame#NotificationCard-error {
    border-color: #8d3a3a;
    background-color: #3a2323;
}

QLabel#NotificationTitle {
    font-weight: bold;
}

/* hydrus indicator colours (dark variants) */

QLabel#HydrusValid       { color: #2ed42e; }
QLabel#HydrusInvalid     { color: #ff7171; }
QLabel#HydrusWarning,
QCheckBox#HydrusWarning  { color: #ff7171; }

QPushButton#HydrusAccept { color: #2ed42e; }
QPushButton#HydrusCancel { color: #ff7171; }

QLineEdit#HydrusValid,   QPlainTextEdit#HydrusValid,   QTextEdit#HydrusValid   { background-color: #80ff80; color: #000000; }
QLineEdit#HydrusInvalid, QPlainTextEdit#HydrusInvalid, QTextEdit#HydrusInvalid { background-color: #ff8080; color: #000000; }
